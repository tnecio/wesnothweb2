":"event","config":{"attrs":{"name":"die"},"children":[{"tag":"filter","config":{"attrs":{"side":2},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Growloff","message":{"t":[["wesnoth-dw","You killed my pet! You’ll pay for that!"]]}},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"last breath"},"children":[{"tag":"filter","config":{"attrs":{"id":"Growloff"},"children":[]}},{"tag":"modify_unit","config":{"attrs":{"hitpoints":1},"children":[{"tag":"filter","config":{"attrs":{"id":"Growloff"},"children":[]}}]}},{"tag":"message","config":{"attrs":{"speaker":"Growloff","message":{"t":[["wesnoth-dw","Don’t kill me!"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","But you attacked us with these monsters."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Growloff","message":{"t":[["wesnoth-dw","They are my friends. I’ve been so lonely here...and you killed so many of my friends. They could be your friends too. Spare me, and I’ll give you my favorite cuttlefish. His name is Inky."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","I do not want a dangerous beast like that!"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Growloff","message":{"t":[["wesnoth-dw","But he’s tame! Really! He understands dozens of commands. He’ll do what you tell him. He’s a really nice fish."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Cylanna","message":{"t":[["wesnoth-dw","Maybe we could use a pet sea monster."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Very well. I will take the cuttlefish. But do not trouble us again, or I shall kill you and all the rest of your pets."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Growloff","message":{"t":[["wesnoth-dw","Of course, of course. I promise! I never wanted to hurt you nice people anyway."]]}},"children":[]}},{"tag":"unit","config":{"attrs":{"x":6,"y":3,"type":"Cuttle Fish","side":1,"id":"Inky","name":{"t":[["wesnoth-dw","Inky"]]},"animate":true},"children":[{"tag":"modifications","config":{"attrs":{},"children":[{"tag":"trait","config":{"attrs":{"id":"loyal","male_name":{"t":[["wesnoth-help","loyal"]]},"female_name":{"t":[["wesnoth-help","female^loyal"]]},"description":{"t":[["wesnoth-help","Zero upkeep"]]},"help_text":{"t":[["wesnoth-help","<i>Loyal</i> units don’t incur upkeep. Most units incur an upkeep cost at the end of every turn, which is equal to their level. Loyal units do not incur this cost."],"\n\n",["wesnoth-help","During campaigns, certain units may opt to join the player’s forces of their own volition. These units are marked with the loyal trait. Although they may require payment to be recalled, they never incur any upkeep costs. This can make them invaluable during a long campaign, when gold is in short supply. This trait is never given to recruited units, so it may be unwise to dismiss such units or to send them to a foolish death."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"loyal"},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"overlay","add":"misc/loyal-icon.png"},"children":[]}}]}},{"tag":"trait","config":{"attrs":{"id":"healthy","male_name":{"t":[["wesnoth-help","healthy"]]},"female_name":{"t":[["wesnoth-help","female^healthy"]]},"description":{"t":[["wesnoth-help","Always rest heals"]]},"help_text":{"t":[["wesnoth-help","Renowned for their vitality, some dwarves are sturdier than others and can rest even when traveling."],"\n\n",["wesnoth-help","<i>Healthy</i> units have 1 additional hitpoint, and gain 1 more per level. They will also heal 2 hitpoints each turn, regardless of whether they engaged in combat the turn before."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"healthy"},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"hitpoints","increase_total":1},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"hitpoints","times":"per level","increase_total":1},"children":[]}}]}}]}}]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Right. Tell me how to control this thing."]]}},"children":[]}},{"tag":"endlevel","config":{"attrs":{"result":"victory","bonus":true,"carryover_add":true,"carryover_percentage":40},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"die"},"children":[{"tag":"filter","config":{"attrs":{"id":"Cylanna"},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Cylanna! I need you!"]]}},"children":[]}},{"tag":"endlevel","config":{"attrs":{"result":"defeat"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"die"},"children":[{"tag":"filter","config":{"attrs":{"id":"Kai Krellis"},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Cylanna","message":{"t":[["wesnoth-dw","We are lost without our king!"]]}},"children":[]}},{"tag":"endlevel","config":{"attrs":{"result":"defeat"},"children":[]}}]}}]}}