":"$side_number","type":"Saurian Oracle","count":"4-infinity"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"disallow_recruit","config":{"attrs":{"side":"$side_number","type":"Saurian Oracle"},"children":[]}}]}},{"tag":"else","config":{"attrs":{},"children":[{"tag":"allow_recruit","config":{"attrs":{"side":"$side_number","type":"Saurian Oracle"},"children":[]}}]}}]}}]}},{"tag":"event","config":{"attrs":{"name":"recruit","first_time_only":false},"children":[{"tag":"filter","config":{"attrs":{"side":5,"type":"Saurian Oracle"},"children":[]}},{"tag":"filter_condition","config":{"attrs":{},"children":[{"tag":"have_unit","config":{"attrs":{"side":"$side_number","type":"Saurian Oracle","count":"4-infinity"},"children":[]}}]}},{"tag":"disallow_recruit","config":{"attrs":{"side":"$side_number","type":"Saurian Oracle"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"prestart"},"children":[{"tag":"item","config":{"attrs":{"x":23,"y":27,"image":"units/drakes/burner.png~TC(2,magenta)"},"children":[]}},{"tag":"item","config":{"attrs":{"x":23,"y":27,"image":"items/large_cage.png"},"children":[]}},{"tag":"item","config":{"attrs":{"x":15,"y":10,"image":"units/human-outlaws/poacher.png~TC(2,magenta)"},"children":[]}},{"tag":"item","config":{"attrs":{"x":15,"y":10,"image":"items/cage.png"},"children":[]}},{"tag":"item","config":{"attrs":{"x":3,"y":3,"image":"scenery/shipwreck-1.png"},"children":[]}},{"tag":"item","config":{"attrs":{"x":5,"y":4,"image":"items/underwater_rock1.png"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"start"},"children":[{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","There are cages on the shore. I wonder why."]]}},"children":[]}},{"tag":"move_unit_fake","config":{"attrs":{"type":"Merman Brawler","x":"15,5","y":"29,28","side":1},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Brawler","id":"Teeloa","name":{"t":[["wesnoth-dw","Teelöa"]]},"unrenamable":true,"x":5,"y":28,"side":1},"children":[{"tag":"modifications","config":{"attrs":{},"children":[{"tag":"trait","config":{"attrs":{"id":"loyal","male_name":{"t":[["wesnoth-help","loyal"]]},"female_name":{"t":[["wesnoth-help","female^loyal"]]},"description":{"t":[["wesnoth-help","Zero upkeep"]]},"help_text":{"t":[["wesnoth-help","<i>Loyal</i> units don’t incur upkeep. Most units incur an upkeep cost at the end of every turn, which is equal to their level. Loyal units do not incur this cost."],"\n\n",["wesnoth-help","During campaigns, certain units may opt to join the player’s forces of their own volition. These units are marked with the loyal trait. Although they may require payment to be recalled, they never incur any upkeep costs. This can make them invaluable during a long campaign, when gold is in short supply. This trait is never given to recruited units, so it may be unwise to dismiss such units or to send them to a foolish death."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"loyal"},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"overlay","add":"misc/loyal-icon.png"},"children":[]}}]}},{"tag":"trait","config":{"attrs":{"id":"resilient","male_name":{"t":[["wesnoth-help","resilient"]]},"female_name":{"t":[["wesnoth-help","female^resilient"]]},"help_text":{"t":[["wesnoth-help","<i>Resilient</i> units have an additional 4 hitpoints, and gain 1 more per level."],"\n\n",["wesnoth-help","Resilient units can be useful at all stages of a campaign, and this is a useful trait for all units. Resilient is often most helpful as a trait when it occurs in a unit that has some combination of low hitpoints, good defense, or high resistances. Resilient units are especially useful for holding strategic positions against opponents."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"hitpoints","increase_total":4},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"hitpoints","times":"per level","increase_total":1},"children":[]}}]}}]}}]}},{"tag":"message","config":{"attrs":{"speaker":"Teeloa","message":{"t":[["wesnoth-dw","Help! Save me!"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Who are you? What is happening?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Teeloa","message":{"t":[["wesnoth-dw","My name is Teelöa. I have been a slave to these saurians for almost two years. I saw you coming up the coast in strength, so I fled. They follow in my wake, and without your protection they will surely kill me."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","A slave!"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Gilak","message":{"t":[["wesnoth-dw","You! Merman! You have some property of oursss. Return it at once if you value your life."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","If you mean this merman, Teelöa, he is no longer your property. No person should be the property of another. Release all your slaves, or the wrath of the merfolk will fall upon you!"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Cylanna","message":{"t":[["wesnoth-dw","A brave and kindhearted choice! I cannot abide slavery."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Gwabbo","message":{"t":[["wesnoth-dw","Those were the words of a man and a leader, Kai Krellis, and well spoken. The folk are truly yours now."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"narrator","image":"wesnoth-icon.png","message":{"t":[["wesnoth-dw","Kai Krellis saw that it was so. The refugee merfolk, sore in their pride from fleeing their enemies, cheered his ultimatum and made ready to fight with a will."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Gilak","message":{"t":[["wesnoth-dw","Foolish merman! You will sssoon wish you had minded your own affairs."]]}},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"turn 2"},"children":[{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Perhaps if I called out to the slaves, I could rouse them to help us fight against their captors."]]}},"children":[]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"have_unit","config":{"attrs":{"id":"Gwabbo"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Gwabbo","message":{"t":[["wesnoth-dw","I think that would work. If I may make a suggestion though, I think we should wait for a more strategic moment."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Never hesitate to speak your counsel to me, Gwabbo. You have been my right arm on this journey; your courage and loyalty are well proven."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Cylanna","message":{"t":[["wesnoth-dw","Those are the words of a true kai and your father’s son. I am proud of you, Krellis."]]}},"children":[]}}]}},{"tag":"else","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Cylanna","message":{"t":[["wesnoth-dw","I believe that would work, but many of them will be killed if you do it now. It might be better to wait."]]}},"children":[]}}]}}]}},{"tag":"message","config":{"attrs":{"speaker":"narrator","image":"wesnoth-icon.png","message":{"t":[["wesnoth-dw","You can choose when the slaves come out of their villages and attack their captors. When you are ready, right-click anywhere and select ‘Inspire the slaves to revolt’."]]}},"children":[]}},{"tag":"set_menu_item","config":{"attrs":{"id":"peasant_revolt_menu_option","description":{"t":[["wesnoth-dw","Inspire the slaves to revolt"]]}},"children":[{"tag":"command","config":{"attrs":{},"children":[{"tag":"set_menu_item","config":{"attrs":{"id":"peasant_revolt_menu_option"},"children":[{"tag":"show_if","config":{"attrs":{},"children":[{"tag":"not","config":{"attrs":{},"children":[]}}]}}]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Hear this! Slaves, the merfolk have sworn war against your tormentors. If you would be free, arise and seize your liberty!"]]}},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Peasant","x":23,"y":29,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Ruffian","x":21,"y":28,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Ruffian","x":22,"y":28,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Citizen","x":25,"y":24,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Citizen","x":15,"y":29,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Brawler","x":14,"y":28,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Ruffian","x":18,"y":22,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Peasant","x":19,"y":22,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Ruffian","x":25,"y":13,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Peasant","x":24,"y":13,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Peasant","x":22,"y":18,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Peasant","x":23,"y":19,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Thief","x":15,"y":6,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Peasant","x":16,"y":5,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Citizen","x":21,"y":7,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Citizen","x":20,"y":7,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Citizen","x":25,"y":23,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Citizen","x":12,"y":10,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Citizen","x":13,"y":10,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Ruffian","x":16,"y":12,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Peasant","x":17,"y":13,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Thug","x":19,"y":23,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Brawler","x":18,"y":23,"side":2,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Merman Brawler","x":23,"y":28,"side":2,"generate_name":true},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"narrator","message":{"t":[["wesnoth-dw","Cheers erupted from several villages, and former slaves rushed out with whatever meager weapons they could find, or fists and rocks if no weapons were to hand. Screams and curses came from the saurian castles."]]},"image":"wesnoth-icon.png"},"children":[]}}]}}]}}]}},{"tag":"event","config":{"attrs":{"name":"victory"},"children":[{"tag":"set_menu_item","config":{"attrs":{"id":"peasant_revolt_menu_option"},"children":[{"tag":"show_if","config":{"attrs":{},"children":[{"tag":"not","config":{"attrs":{},"children":[]}}]}}]}}]}},{"tag":"event","config":{"attrs":{"name":"moveto","first_time_only":true},"children":[{"tag":"filter","config":{"attrs":{"x":3,"y":3,"side":1},"children":[]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"unit.id","contains":"Bat"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","There is a treasure chest there! Good bat!"]]}},"children":[]}}]}},{"tag":"else","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"unit","message":{"t":[["wesnoth-dw","There is a treasure chest here!"]]}},"children":[]}}]}}]}},{"tag":"sound","config":{"attrs":{"name":"gold.ogg"},"children":[]}},{"tag":"gold","config":{"attrs":{"side":1,"amount":100},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"narrator","message":{"t":[["wesnoth-dw","You receive 100 gold."]]},"image":"wesnoth-icon.png"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"moveto","first_time_only":true},"children":[{"tag":"filter","config":{"attrs":{"x":23,"y":27,"side":1},"children":[]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"unit.id","contains":"Bat"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"unit","message":{"t":[["wesnoth-dw","Neep!"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","I believe our bat is impressed! That must be a drake. I am told they are fearsome, but honorable, creatures. I think we can let him out of the cage."]]}},"children":[]}}]}},{"tag":"else","config":{"attrs":{},"children":[{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"unit.id","equals":"Kai Krellis"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","This must be a drake. I am told they are honorable creatures. I am going to let him out of the cage."]]}},"children":[]}}]}},{"tag":"else","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","That must be a drake. I am told they are fearsome, but honorable, creatures. Let him out of the cage."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"unit","message":{"t":[["wesnoth-dw","Uh...If you say so."]]}},"children":[]}}]}}]}}]}}]}},{"tag":"remove_item","config":{"attrs":{"x":"$x1","y":"$y1"},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Drake Burner","id":"Keshan","name":{"t":[["wesnoth-dw","Keshan"]]},"unrenamable":true,"x":23,"y":27,"side":1},"children":[{"tag":"modifications","config":{"attrs":{},"children":[{"tag":"trait","config":{"attrs":{"id":"loyal","male_name":{"t":[["wesnoth-help","loyal"]]},"female_name":{"t":[["wesnoth-help","female^loyal"]]},"description":{"t":[["wesnoth-help","Zero upkeep"]]},"help_text":{"t":[["wesnoth-help","<i>Loyal</i> units don’t incur upkeep. Most units incur an upkeep cost at the end of every turn, which is equal to their level. Loyal units do not incur this cost."],"\n\n",["wesnoth-help","During campaigns, certain units may opt to join the player’s forces of their own volition. These units are marked with the loyal trait. Although they may require payment to be recalled, they never incur any upkeep costs. This can make them invaluable during a long campaign, when gold is in short supply. This trait is never given to recruited units, so it may be unwise to dismiss such units or to send them to a foolish death."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"loyal"},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"overlay","add":"misc/loyal-icon.png"},"children":[]}}]}},{"tag":"trait","config":{"attrs":{"id":"intelligent","male_name":{"t":[["wesnoth-help","intelligent"]]},"female_name":{"t":[["wesnoth-help","female^intelligent"]]},"help_text":{"t":[["wesnoth-help","<i>Intelligent</i> units require 20% less experience than usual to advance."],"\n\n",["wesnoth-help","Intelligent units are very useful at the beginning of a campaign as they can advance to higher levels more quickly. Later in campaigns Intelligent is not quite as useful because the <i>After Maximum Level Advancement</i> (AMLA) is not as significant a change as advancing a level. If you have many ‘maximum level’ units you may wish to recall units with more desirable traits."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"max_experience","increase":"-20%"},"children":[]}}]}}]}}]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","What is your name?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Keshan","message":{"t":[["wesnoth-dw","I am Keshan."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","How did you come to be in a cage?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Keshan","message":{"t":[["wesnoth-dw","I was hunting north of here when the small ones captured me. I killed many, but I was humiliated in the end."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Will you fight with us, Keshan?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Keshan","message":{"t":[["wesnoth-dw","You have released me, so I owe you a great debt. I will fight with you."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Gwabbo","message":{"t":[["wesnoth-dw","Don’t let him go too crazy. Those saurian spears can go right through his scales."]]}},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"moveto","first_time_only":true},"children":[{"tag":"filter","config":{"attrs":{"x":15,"y":10,"side":1},"children":[]}},{"tag":"remove_item","config":{"attrs":{"x":"$x1","y":"$y1"},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Poacher","id":"Siddry","name":{"t":[["wesnoth-dw","Siddry"]]},"unrenamable":true,"x":15,"y":10,"side":1},"children":[{"tag":"modifications","config":{"attrs":{},"children":[{"tag":"trait","config":{"attrs":{"id":"loyal","male_name":{"t":[["wesnoth-help","loyal"]]},"female_name":{"t":[["wesnoth-help","female^loyal"]]},"description":{"t":[["wesnoth-help","Zero upkeep"]]},"help_text":{"t":[["wesnoth-help","<i>Loyal</i> units don’t incur upkeep. Most units incur an upkeep cost at the end of every turn, which is equal to their level. Loyal units do not incur this cost."],"\n\n",["wesnoth-help","During campaigns, certain units may opt to join the player’s forces of their own volition. These units are marked with the loyal trait. Although they may require payment to be recalled, they never incur any upkeep costs. This can make them invaluable during a long campaign, when gold is in short supply. This trait is never given to recruited units, so it may be unwise to dismiss such units or to send them to a foolish death."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"loyal"},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"overlay","add":"misc/loyal-icon.png"},"children":[]}}]}},{"tag":"trait","config":{"attrs":{"id":"resilient","male_name":{"t":[["wesnoth-help","resilient"]]},"female_name":{"t":[["wesnoth-help","female^resilient"]]},"help_text":{"t":[["wesnoth-help","<i>Resilient</i> units have an additional 4 hitpoints, and gain 1 more per level."],"\n\n",["wesnoth-help","Resilient units can be useful at all stages of a campaign, and this is a useful trait for all units. Resilient is often most helpful as a trait when it occurs in a unit that has some combination of low hitpoints, good defense, or high resistances. Resilient units are especially useful for holding strategic positions against opponents."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"hitpoints","increase_total":4},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"hitpoints","times":"per level","increase_total":1},"children":[]}}]}}]}}]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"unit.id","contains":"Bat"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"unit","message":{"t":[["wesnoth-dw","Neep?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Who are you, and what are you doing in a cage?"]]}},"children":[]}}]}},{"tag":"else","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"unit","message":{"t":[["wesnoth-dw","Who are you, and what are you doing in a cage?"]]}},"children":[]}}]}}]}},{"tag":"message","config":{"attrs":{"speaker":"Siddry","message":{"t":[["wesnoth-dw","My name is Siddry. These cursed saurians nabbed me a week ago — wanted me to turn overseer to their other slaves. I wouldn’t do it, so they caged me with them. They tried to take my bow too, but they had some trouble with that."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","So, you will help us defeat them?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Siddry","message":{"t":[["wesnoth-dw","The way I see it, you’re helping me. There is nothing I would like better than to put their slavery to an end. I can’t swim, so I won’t be able to come with you on your travels, but I will owe you. If there is anything I can do in the future, I will do it."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Well met, then, friend. I am Kai Krellis, leader of the people of Jotha."]]}},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"enemies defeated"},"children":[{"tag":"if","config":{"attrs":{},"children":[{"tag":"have_unit","config":{"attrs":{"side":2},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"side":2,"message":{"t":[["wesnoth-dw","Kai Krellis, you have freed us, and we are forever in your debt. How can we repay you?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","I will not ask you to follow me. You have suffered enough for the benefit of others. Go back to your families if you have them, and work for yourselves from now on."]]}},"children":[]}}]}}]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"have_unit","config":{"attrs":{"id":"Siddry","type":"Poacher,Trapper,Huntsman,Ranger"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"store_unit","config":{"attrs":{"variable":"Siddry_stored","kill":true},"children":[{"tag":"filter","config":{"attrs":{"id":"Siddry"},"children":[]}}]}}]}},{"tag":"else","config":{"attrs":{},"children":[{"tag":"set_variable","config":{"attrs":{"name":"Siddry_stored","value":false},"children":[]}}]}}]}},{"tag":"endlevel","config":{"attrs":{"result":"victory","bonus":true,"carryover_add":true,"carryover_percentage":40},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"die"},"children":[{"tag":"filter","config":{"attrs":{"id":"Cylanna"},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Cylanna! I need you!"]]}},"children":[]}},{"tag":"endlevel","config":{"attrs":{"result":"defeat"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"die"},"children":[{"tag":"filter","config":{"attrs":{"id":"Kai Krellis"},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Cylanna","message":{"t":[["wesnoth-dw","We are lost without our king!"]]}},"children":[]}},{"tag":"endlevel","config":{"attrs":{"result":"defeat"},"children":[]}}]}}]}}