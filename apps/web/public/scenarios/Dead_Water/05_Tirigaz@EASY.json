g":{"attrs":{"type":"Wraith","x":19,"y":19,"side":3},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Wraith","x":17,"y":19,"side":3},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Wraith","x":18,"y":19,"side":3},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Wraith","x":17,"y":18,"side":3},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Wraith","x":20,"y":20,"side":3},"children":[]}},{"tag":"store_unit","config":{"attrs":{"variable":"undead"},"children":[{"tag":"filter","config":{"attrs":{"side":3},"children":[]}}]}},{"tag":"foreach","config":{"attrs":{"array":"undead"},"children":[{"tag":"do","config":{"attrs":{},"children":[{"tag":"set_variable","config":{"attrs":{"name":"number_of_undead","add":1},"children":[]}}]}}]}},{"tag":"clear_variable","config":{"attrs":{"name":"undead"},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","I feared this might happen. We tarried too long fighting the saurians, and the undead have caught up with us. The spirits may have trapped us here for the night, but in the morning we will..."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Marg-Tonz","message":{"t":[["wesnoth-dw","What’s going on? What are you fish-men doing here? Are we constantly to be pestered by you creatures?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Cylanna","message":{"t":[["wesnoth-dw","He’s one to complain about <i>that</i>..."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","We were just passing through."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Marg-Tonz","message":{"t":[["wesnoth-dw","Well, finish passing."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","Actually, we have some ghosts after us now, and we would like to shelter here for a while."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Marg-Tonz","message":{"t":[["wesnoth-dw","Forget about it! We don’t want no trouble, but get off our land! Ghosts who don’t like fish are your problem."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","If you give us a few hours to regroup and prepare our soldiers, we will go without causing you trouble."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Marg-Tonz","message":{"t":[["wesnoth-dw","You have one hour. After that, we are tearing down that old encampment. You stay in the water if you know what’s good for you. If you set foot...or whatever...on land again, we’ll cut your throats. And stay off our piers. And don’t touch the ships neither!"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Cylanna","message":{"t":[["wesnoth-dw","I wonder how he gets customers with manners like that."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","One hour will work for us. It will not take all of us to defeat the undead. "],"<small>(",["wesnoth-dw","We can decide what to do about the orc after that."],")</small>"]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"narrator","message":{"t":[["wesnoth-dw","You will only be able to use your keep for one turn."]]},"image":"wesnoth-icon.png"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"turn 2"},"children":[{"tag":"event","config":{"attrs":{"name":"side turn","first_time_only":false},"children":[{"tag":"if","config":{"attrs":{},"children":[{"tag":"and","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"side_number","equals":2},"children":[]}},{"tag":"variable","config":{"attrs":{"name":"orcs_passive","equals":true},"children":[]}},{"tag":"have_unit","config":{"attrs":{"side":1},"children":[{"tag":"not","config":{"attrs":{},"children":[{"tag":"filter_location","config":{"attrs":{"terrain":"Ww,Wo,Wwf"},"children":[]}}]}}]}}]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Marg-Tonz","message":{"t":[["wesnoth-dw","You’re still squatting on our land! I warned you."]]}},"children":[]}},{"tag":"set_variable","config":{"attrs":{"name":"orcs_passive","value":false},"children":[]}},{"tag":"modify_side","config":{"attrs":{"side":2,"income":0,"recruit":"Orcish Grunt,Orcish Warrior,Orcish Archer,Orcish Crossbowman,Orcish Assassin,Orcish Slayer"},"children":[]}}]}}]}}]}}]}},{"tag":"event","config":{"attrs":{"name":"turn 3"},"children":[{"tag":"event","config":{"attrs":{"name":"moveto","first_time_only":true},"children":[{"tag":"filter","config":{"attrs":{"side":1},"children":[{"tag":"not","config":{"attrs":{},"children":[{"tag":"filter_location","config":{"attrs":{"terrain":"Ww,Wo,Wwf"},"children":[]}}]}}]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"orcs_passive","equals":true},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Marg-Tonz","message":{"t":[["wesnoth-dw","I told you to stay off our land! Now you’re in for it."]]}},"children":[]}},{"tag":"set_variable","config":{"attrs":{"name":"orcs_passive","value":false},"children":[]}},{"tag":"modify_side","config":{"attrs":{"side":2,"income":0,"recruit":"Orcish Grunt,Orcish Warrior,Orcish Archer,Orcish Crossbowman,Orcish Assassin,Orcish Slayer"},"children":[]}}]}},{"tag":"else","config":{"attrs":{},"children":[{"tag":"allow_undo","config":{"attrs":{},"children":[]}}]}}]}}]}}]}},{"tag":"event","config":{"attrs":{"name":"attack_end","first_time_only":true},"children":[{"tag":"filter","config":{"attrs":{"side":1},"children":[]}},{"tag":"filter_second","config":{"attrs":{"side":2},"children":[]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"orcs_passive","equals":true},"children":[]}},{"tag":"then","config":{"at