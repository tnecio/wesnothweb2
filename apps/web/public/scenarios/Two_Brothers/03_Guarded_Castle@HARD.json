c-dark.ogg"},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Soulless","side":2,"x":29,"y":3,"animate":true},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"unit","message":{"t":[["wesnoth-tb","What sort of creature have I summoned here?!"]]}},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"moveto"},"children":[{"tag":"filter_condition","config":{"attrs":{},"children":[{"tag":"have_location","config":{"attrs":{"x":5,"y":5},"children":[{"tag":"filter_vision","config":{"attrs":{"side":1},"children":[]}}]}}]}},{"tag":"scroll_to","config":{"attrs":{"x":3,"y":3},"children":[]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"baran_store.id","equals":"Baran"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"unstore_unit","config":{"attrs":{"variable":"baran_store","x":"recall","y":"recall"},"children":[]}},{"tag":"clear_variable","config":{"attrs":{"name":"baran_store"},"children":[]}}]}}]}},{"tag":"recall","config":{"attrs":{"id":"Baran","x":3,"y":3},"children":[]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"not","config":{"attrs":{},"children":[{"tag":"have_unit","config":{"attrs":{"side":1,"id":"Baran"},"children":[]}}]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"unit","config":{"attrs":{"id":"Baran","name":{"t":[["wesnoth-tb","Baran"]]},"unrenamable":true,"type":"Red Mage","profile":"portraits/baran.webp","side":1,"x":3,"y":3},"children":[{"tag":"modifications","config":{"attrs":{},"children":[{"tag":"trait","config":{"attrs":{"id":"loyal","male_name":{"t":[["wesnoth-help","loyal"]]},"female_name":{"t":[["wesnoth-help","female^loyal"]]},"description":{"t":[["wesnoth-help","Zero upkeep"]]},"help_text":{"t":[["wesnoth-help","<i>Loyal</i> units don’t incur upkeep. Most units incur an upkeep cost at the end of every turn, which is equal to their level. Loyal units do not incur this cost."],"\n\n",["wesnoth-help","During campaigns, certain units may opt to join the player’s forces of their own volition. These units are marked with the loyal trait. Although they may require payment to be recalled, they never incur any upkeep costs. This can make them invaluable during a long campaign, when gold is in short supply. This trait is never given to recruited units, so it may be unwise to dismiss such units or to send them to a foolish death."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"loyal"},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"overlay","add":"misc/hero-icon.png"},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"ellipse","ellipse":"misc/ellipse-hero"},"children":[]}}]}},{"tag":"trait","config":{"attrs":{"id":"intelligent","male_name":{"t":[["wesnoth-help","intelligent"]]},"female_name":{"t":[["wesnoth-help","female^intelligent"]]},"help_text":{"t":[["wesnoth-help","<i>Intelligent</i> units require 20% less experience than usual to advance."],"\n\n",["wesnoth-help","Intelligent units are very useful at the beginning of a campaign as they can advance to higher levels more quickly. Later in campaigns Intelligent is not quite as useful because the <i>After Maximum Level Advancement</i> (AMLA) is not as significant a change as advancing a level. If you have many ‘maximum level’ units you may wish to recall units with more desirable traits."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"max_experience","increase":"-20%"},"children":[]}}]}}]}}]}}]}}]}},{"tag":"redraw","config":{"attrs":{"side":1},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"unit","message":{"t":[["wesnoth-tb","I found Baran. He is in this cell."]]}},"children":[]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"unit.id","equals":"Arvith"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Baran","message":{"t":[["wesnoth-tb","It’s good to see you, Arvith."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Arvith","message":{"t":[["wesnoth-tb","And you too, brother."]]}},"children":[]}}]}},{"tag":"else","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Baran","message":{"t":[["wesnoth-tb","You must be one of Arvith’s men. Please help me get out of this dungeon."]]}},"children":[]}}]}}]}},{"tag":"message","config":{"attrs":{"speaker":"Baran","message":{"t":[["wesnoth-tb","The accursed dark sorcerer Rotharik has imprisoned me behind this magically enhanced iron gate. It can only be opened with the correct key. You must get it from him to free me."]]}},"children":[]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"not","config":{"attrs":{},"children":[{"tag":"have_unit","config":{"attrs":{"id":"Rotharik"},"children":[]}}]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"message","config":{"attrs":{"speaker":"Arvith","message":{"t":[["wesnoth-tb","I have already met, and killed, the sorcerer. Is this the key to which you referred?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Baran","message":{"t":[["wesnoth-tb","Yes, it is. Come, unlock this cell door, and let us depart this place, brother!"]]}},"children":[]}},{"tag":"store_turns","config":{"attrs":{"variable":"turns_remaining"},"children":[]}},{"tag":"set_variable","config":{"attrs":{"name":"turns_remaining","sub":"$($turn_number|-1)"},"children":[]}},{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"turns_remaining","less_than":7},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"modify_turns","config":{"attrs":{"add":"$(7-$turns_remaining|)"},"children":[]}}]}}]}},{"tag":"clear_variable","config":{"attrs":{"name":"turns_remaining"},"children":[]}}]}}]}},{"tag":"show_objectives","config":{"attrs":{},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"moveto","first_time_only":false},"children":[{"tag":"filter","config":{"attrs":{"x":"5,6","y":"6,5","id":"Arvith"},"children":[]}},{"tag":"filter_condition","config":{"attrs":{},"children":[{"tag":"not","config":{"attrs":{},"children":[{"tag":"have_unit","config":{"attrs":{"id":"Rotharik"},"children":[]}}]}}]}},{"tag":"remove_item","config":{"attrs":{"x":5,"y":5},"children":[]}},{"tag":"terrain","config":{"attrs":{"x":5,"y":5,"terrain":"Uu"},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Baran","message":{"t":[["wesnoth-tb","Thank you for saving me. I... was not certain you would come."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Arvith","message":{"t":[["wesnoth-tb","Have you no faith in your brother, Baran?"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Baran","message":{"t":[["wesnoth-tb","It’s not that. Perhaps I deserved to rot here. I failed you. I failed you again."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Arvith","message":{"t":[["wesnoth-tb","That is as may be. But you are my brother still. And... I never doubted you would have come for me."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Arvith","message":{"t":[["wesnoth-tb","It was no great trial, after all. A few elves, one or two dark sorcerers, a gang of orcs and some undead. Really just a day’s work for the company."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Baran","message":{"t":[["wesnoth-tb","Thank you for coming to my aid. Let us return to the village."]]}},"children":[]}},{"tag":"endlevel","config":{"attrs":{"result":"victory","bonus":true,"carryover_add":true,"carryover_percentage":40},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"victory"},"children":[{"tag":"if","config":{"attrs":{},"children":[{"tag":"variable","config":{"attrs":{"name":"baran_store.id","equals":"Baran"},"children":[]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"unstore_unit","config":{"attrs":{"variable":"baran_store","x":"recall","y":"recall"},"children":[]}},{"tag":"clear_variable","config":{"attrs":{"name":"baran_store"},"children":[]}}]}}]}}]}},{"tag":"event","config":{"attrs":{"name":"last breath"},"children":[{"tag":"filter","config":{"attrs":{"id":"Baran"},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Baran","message":{"t":[["wesnoth-tb","It is over, I am vanquished."]]}},"children":[]}},{"tag":"endlevel","config":{"attrs":{"result":"defeat"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"last breath"},"children":[{"tag":"filter","config":{"attrs":{"id":"Arvith"},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Arvith","message":{"t":[["wesnoth-tb","All is lost now that I am dead..."]]}},"children":[]}},{"tag":"endlevel","config":{"attrs":{"result":"defeat"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"time over"},"children":[{"tag":"if","config":{"attrs":{},"children":[{"tag":"not","config":{"attrs":{},"children":[{"tag":"have_unit","config":{"attrs":{"id":"Rotharik"},"children":[]}}]}},{"tag":"then","config":{"attrs":{},"children":[{"tag":"unit","config":{"attrs":{"id":"Rotharik","side":2,"type":"Orcish Assassin","name":{"t":[["wesnoth-tb","Minion of Tairach"]]},"x":2,"y":2},"children":[]}},{"tag":"kill","config":{"attrs":{"id":"Baran"},"children":[]}}]}}]}},{"tag":"message","config":{"attrs":{"speaker":"Rotharik","scroll":false,"message":{"t":[["wesnoth-tb","You are too late! Your brother is already dead! Muahahaha...!"]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Arvith","message":{"t":[["wesnoth-tb","Argh!!"]]}},"children":[]}}]}}]}}