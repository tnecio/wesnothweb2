75,"green":-45,"blue":-13},"children":[]}},{"tag":"side","config":{"attrs":{"side":1,"controller":"human","team_name":"good guys","user_team_name":{"t":[["wesnoth-dw","user_team_name^Merfolk"]]},"type":"Merman Child King","id":"Kai Krellis","name":{"t":[["wesnoth-dw","Kai Krellis"]]},"canrecruit":true,"unrenamable":true,"recruit":"Merman Citizen,Merman Fighter,Merman Hunter,Mermaid Initiate","income":-2,"gold":0},"children":[]}},{"tag":"side","config":{"attrs":{"side":2,"controller":"ai","user_team_name":{"t":[["wesnoth-dw","Tyegëa and Priestesses"]]},"team_name":"good guys","id":"Tyegea","name":{"t":[["wesnoth-dw","Tyegëa"]]},"canrecruit":true,"type":"Mermaid Diviner"},"children":[{"tag":"modifications","config":{"attrs":{},"children":[{"tag":"trait","config":{"attrs":{"id":"loyal","male_name":{"t":[["wesnoth-help","loyal"]]},"female_name":{"t":[["wesnoth-help","female^loyal"]]},"description":{"t":[["wesnoth-help","Zero upkeep"]]},"help_text":{"t":[["wesnoth-help","<i>Loyal</i> units don’t incur upkeep. Most units incur an upkeep cost at the end of every turn, which is equal to their level. Loyal units do not incur this cost."],"\n\n",["wesnoth-help","During campaigns, certain units may opt to join the player’s forces of their own volition. These units are marked with the loyal trait. Although they may require payment to be recalled, they never incur any upkeep costs. This can make them invaluable during a long campaign, when gold is in short supply. This trait is never given to recruited units, so it may be unwise to dismiss such units or to send them to a foolish death."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"loyal"},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"overlay","add":""},"children":[]}}]}},{"tag":"trait","config":{"attrs":{"id":"dextrous","male_name":{"t":[["wesnoth-help","dextrous"]]},"female_name":{"t":[["wesnoth-help","female^dextrous"]]},"help_text":{"t":[["wesnoth-help","<i>Dextrous</i> units do 1 more damage for every successful strike in ranged combat."],"\n\n",["wesnoth-help","Dextrous is a trait possessed only by elves. The elven people are known for their uncanny grace, and their great facility with the bow. Some, however, are gifted with natural talent that exceeds their brethren. These elves inflict an additional point of damage with each arrow."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"attack","range":"ranged","increase_damage":1},"children":[]}}]}}]}},{"tag":"ai","config":{"attrs":{"ai_algorithm":"idle_ai"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"prestart"},"children":[{"tag":"store_starting_location","config":{"attrs":{"side":2,"variable":"temp_starting_location"},"children":[]}},{"tag":"capture_village","config":{"attrs":{"side":2,"terrain":"*^V*"},"children":[{"tag":"and","config":{"attrs":{"x":"$temp_starting_location.x","y":"$temp_starting_location.y","radius":99},"children":[]}}]}},{"tag":"clear_variable","config":{"attrs":{"name":"temp_starting_location"},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"prestart"},"children":[{"tag":"music","config":{"attrs":{"name":"elf-land.ogg"},"children":[]}},{"tag":"music","config":{"attrs":{"name":"elvish-theme.ogg","append":true},"children":[]}},{"tag":"recall","config":{"attrs":{"id":"Cylanna"},"children":[]}},{"tag":"recall","config":{"attrs":{"id":"Gwabbo"},"children":[]}},{"tag":"recall","config":{"attrs":{"id":"Teeloa"},"children":[]}},{"tag":"recall","config":{"attrs":{"id":"Keshan"},"children":[]}},{"tag":"recall","config":{"attrs":{"id":"Inky"},"children":[]}},{"tag":"recall","config":{"attrs":{"id":"Tyegea"},"children":[]}},{"tag":"recall","config":{"attrs":{"id":"Friendly Bat"},"children":[]}},{"tag":"recall","config":{"attrs":{"id":"Undead Bat"},"children":[]}},{"tag":"recall","config":{"attrs":{"id":"Fearsome Bat"},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Mermaid Priestess","side":2,"x":4,"y":4,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Mermaid Priestess","side":2,"x":13,"y":4,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Mermaid Priestess","side":2,"x":12,"y":8,"generate_name":true},"children":[]}},{"tag":"unit","config":{"attrs":{"type":"Mermaid Priestess","side":2,"x":9,"y":11,"generate_name":true},"children":[]}}]}},{"tag":"event","config":{"attrs":{"name":"start"},"children":[{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","We have brought the Flaming Sword. Caladon tried to steal it for himself, but we were able to get it back from him."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Tyegea","message":{"t":[["wesnoth-dw","He did not part with it willingly, so he must be dead."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Kai Krellis","message":{"t":[["wesnoth-dw","It is as you say."]]}},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"Tyegea","message":{"t":[["wesnoth-dw","No matter. He was a fool. Now, you have done as I asked, grandson, so I will travel with you to your home and help you rid it of restless spirits. My priestesses will come as well, and will be at your disposal."]]}},"children":[]}},{"tag":"modify_unit","config":{"attrs":{"side":1,"canrecruit":false},"children":[{"tag":"filter","config":{"attrs":{"id":"Tyegea"},"children":[]}}]}},{"tag":"unit_overlay","config":{"attrs":{"x":"$Tyegea_stored.x","y":"$Tyegea_stored.y","image":"misc/loyal-icon.png"},"children":[]}},{"tag":"allow_recruit","config":{"attrs":{"type":"Mermaid Priestess","side":1},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"narrator","message":{"t":[["wesnoth-dw","You may now recruit mermaid priestesses!"]]},"image":"wesnoth-icon.png"},"children":[]}},{"tag":"remove_trait","config":{"attrs":{"id":"Cylanna","trait_id":"loyal"},"children":[]}},{"tag":"modify_unit","config":{"attrs":{},"children":[{"tag":"filter","config":{"attrs":{"id":"Cylanna"},"children":[]}},{"tag":"trait","config":{"attrs":{"id":"loyal","male_name":{"t":[["wesnoth-help","loyal"]]},"female_name":{"t":[["wesnoth-help","female^loyal"]]},"description":{"t":[["wesnoth-help","Zero upkeep"]]},"help_text":{"t":[["wesnoth-help","<i>Loyal</i> units don’t incur upkeep. Most units incur an upkeep cost at the end of every turn, which is equal to their level. Loyal units do not incur this cost."],"\n\n",["wesnoth-help","During campaigns, certain units may opt to join the player’s forces of their own volition. These units are marked with the loyal trait. Although they may require payment to be recalled, they never incur any upkeep costs. This can make them invaluable during a long campaign, when gold is in short supply. This trait is never given to recruited units, so it may be unwise to dismiss such units or to send them to a foolish death."]]}},"children":[{"tag":"effect","config":{"attrs":{"apply_to":"loyal"},"children":[]}},{"tag":"effect","config":{"attrs":{"apply_to":"overlay","add":"misc/loyal-icon.png"},"children":[]}}]}}]}},{"tag":"message","config":{"attrs":{"speaker":"Tyegea","message":{"t":[["wesnoth-dw","Also, I have a little gold I can bring along."]]}},"children":[]}},{"tag":"sound","config":{"attrs":{"name":"gold.ogg"},"children":[]}},{"tag":"gold","config":{"attrs":{"side":1,"amount":55},"children":[]}},{"tag":"message","config":{"attrs":{"speaker":"narrator","message":{"t":[["wesnoth-dw","You receive 55 gold."]]},"image":"wesnoth-icon.png"},"children":[]}},{"tag":"endlevel","config":{"attrs":{"result":"victory","linger_mode":false,"carryover_report":false,"replay_save":false,"carryover_add":true,"carryover_percentage":100},"children":[]}}]}}]}}