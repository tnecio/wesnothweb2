// Phase 32: the statistics and bug-report Worker (see src/handler.ts and docs/DEPLOYMENT.md). Deployed by hand,
// separately from the game: `npx wrangler deploy` in this directory.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wesnoth-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "routes": [{ "pattern": "wesnoth-stats.tnec.io", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wesnoth-stats",
      // From `wrangler d1 create wesnoth-stats` (docs/DEPLOYMENT.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Private: unlike wesnothweb2-data, nothing here is served to the public.
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "wesnoth-reports" }],
  // Unrestricted here: the destination is the MAIL_TO secret, so the address stays out of this public repo.
  // Email Routing only delivers to verified destination addresses.
  "send_email": [{ "name": "MAILER" }],
  "ratelimits": [
    { "name": "EVENT_LIMIT", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } },
    { "name": "REPORT_LIMIT", "namespace_id": "3002", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://wesnoth.tnec.io,https://wesnothweb2.tomasz-necio.workers.dev,http://localhost:5173",
    "REPORTS_ENABLED": "true",
    "MAIL_FROM": "stats@tnec.io"
  },
  // The daily clean-up: events after 13 months, report rows after 12 (`cleanUp`).
  "triggers": { "crons": ["17 3 * * *"] }
}
